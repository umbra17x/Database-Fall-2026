  <diagram id="9GzVM4ZhRKlUyeTXELGG" name="Страница-2">
    <mxGraphModel dx="1718" dy="1203" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="6EErnaPTz-ou-0HBThs3-1" parent="1" style="text;whiteSpace=wrap;html=1;strokeWidth=3;fontSize=15;" value="&lt;p dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;The Airport Database is designed to manage information about airports, airlines, flights, passengers, bookings, boarding passes, baggage, and security checks.&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Airport&lt;/strong&gt; stores information about airports, including their name, country, state, city, and creation/update dates.&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Airline&lt;/strong&gt; stores information about airline companies. One airline can operate many flights.&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Flight&lt;/strong&gt; stores scheduled and actual flight information. Each flight is associated with an airline, a departure airport, and an arrival airport.&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Passenger&lt;/strong&gt; stores personal information about passengers, including name, date of birth, citizenship, residence, and passport number.&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Booking&lt;/strong&gt; represents a passenger&#39;s reservation for a particular flight. It stores the booking status, platform, ticket price, passenger, and flight.&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Boarding Pass&lt;/strong&gt; stores information about boarding passes issued for bookings, including seat and boarding time.&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Baggage&lt;/strong&gt; stores information about baggage registered for a booking, including its weight.&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Baggage Check&lt;/strong&gt; stores the results of baggage checks associated with bookings and passengers.&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Security Check&lt;/strong&gt; stores the results of security checks performed for passengers.&lt;/p&gt;&#xa;&lt;p dir=&quot;auto&quot;&gt;&lt;strong&gt;Booking Change&lt;/strong&gt; stores information about changes made to existing bookings.&lt;/p&gt;" vertex="1">
          <mxGeometry height="680" width="560" x="50" y="70" as="geometry" />
        </mxCell>
        <mxCell id="6EErnaPTz-ou-0HBThs3-2" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=25;fontStyle=1" value="Key and Relationship Notation" vertex="1">
          <mxGeometry height="40" width="430" x="70" y="960" as="geometry" />
        </mxCell>
        <mxCell id="6EErnaPTz-ou-0HBThs3-4" edge="1" parent="1" source="6EErnaPTz-ou-0HBThs3-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="1070" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="6EErnaPTz-ou-0HBThs3-3" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=18;" value="PK – Primary Key, uniquely identifies each record.&#xa;FK – Foreign Key, connects one table to another.&#xa;1:N – One-to-Many relationship.&#xa;Crow&#39;s Foot symbol – represents the &quot;many&quot; side of a relationship." vertex="1">
          <mxGeometry height="80" width="580" x="70" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="6EErnaPTz-ou-0HBThs3-5" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=27;fontStyle=1" value="Relationships" vertex="1">
          <mxGeometry height="40" width="110" x="890" y="70" as="geometry" />
        </mxCell>
        <mxCell id="6EErnaPTz-ou-0HBThs3-6" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=19;" value="Airline 1:N Flight&#xa;Airport 1:N Flight (Departure Airport)&#xa;Airport 1:N Flight (Arrival Airport)&#xa;Flight 1:N Booking&#xa;Passenger 1:N Booking&#xa;Booking 1:N Boarding Pass&#xa;Booking 1:N Baggage&#xa;Booking 1:N Baggage Check&#xa;Passenger 1:N Baggage Check&#xa;Passenger 1:N Security Check&#xa;Booking 1:N Booking Change" vertex="1">
          <mxGeometry height="290" width="490" x="860" y="140" as="geometry" />
        </mxCell>
      </root>
